POSTGRES_USER=documenso
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=documenso

NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32
NEXT_PRIVATE_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=replace-with-openssl-rand-hex-32

NEXT_PUBLIC_WEBAPP_URL=https://contracts.builtbybrendan.com
NEXT_PRIVATE_INTERNAL_WEBAPP_URL=http://localhost:3000

NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
NEXT_PRIVATE_SMTP_HOST=smtp.resend.com
NEXT_PRIVATE_SMTP_PORT=587
NEXT_PRIVATE_SMTP_USERNAME=resend
NEXT_PRIVATE_SMTP_PASSWORD=replace-with-resend-api-key
NEXT_PRIVATE_SMTP_FROM_NAME=Built by Brendan Contracts
NEXT_PRIVATE_SMTP_FROM_ADDRESS=contracts@builtbybrendan.com

NEXT_PRIVATE_SIGNING_TRANSPORT=local
NEXT_PRIVATE_SIGNING_LOCAL_FILE_PATH=/opt/documenso/cert.p12
NEXT_PRIVATE_SIGNING_PASSPHRASE=replace-with-your-p12-password

NEXT_PUBLIC_DISABLE_SIGNUP=false
NEXT_PUBLIC_UPLOAD_TRANSPORT=database
